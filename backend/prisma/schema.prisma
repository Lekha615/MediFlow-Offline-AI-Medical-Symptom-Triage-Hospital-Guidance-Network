generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model State {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]

  @@map("states")
}

model City {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(100)
  stateId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  state     State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  hospitals Hospital[]

  @@unique([name, stateId])
  @@map("cities")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique @db.VarChar(50)
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  slug            String           @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String            @id @default(uuid())
  roleId            String
  hospitalId        String?
  email             String            @unique @db.VarChar(255)
  phoneNumber       String            @unique @db.VarChar(15)
  passwordHash      String            @db.VarChar(255)
  fcmToken          String?
  status            EntityStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  auditLogs         AuditLog[]
  doctor            Doctor?
  feedbacks         Feedback[]
  uploadedDocuments MedicalDocument[] @relation("UploadedDocuments")
  verifiedDocuments MedicalDocument[] @relation("VerifiedDocuments")
  sentNotifications Notification[]    @relation("SenderUser")
  notifications     Notification[]    @relation("RecipientUser")
  otps              Otp[]
  patient           Patient?
  sessions          Session[]
  staff             Staff?
  supportTickets    SupportTicket[]   @relation("UserSupportTickets")
  hospital          Hospital?         @relation(fields: [hospitalId], references: [id])
  role              Role              @relation(fields: [roleId], references: [id])

  @@index([email, phoneNumber])
  @@index([hospitalId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Otp {
  id          String   @id @default(uuid())
  userId      String?
  phoneNumber String   @db.VarChar(15)
  otpCode     String   @db.VarChar(6)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, otpCode])
  @@map("otps")
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(100)
  price         Decimal        @db.Decimal(10, 2)
  durationDays  Int
  maxDoctors    Int
  maxStaff      Int
  features      Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String           @id @default(uuid())
  hospitalId String           @unique
  planId     String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Hospital {
  id            String                 @id @default(uuid())
  cityId        String
  name          String                 @db.VarChar(255)
  code          String                 @unique @db.VarChar(20)
  type          HospitalType
  speciality    SpecialityType
  address       String
  latitude      Float
  longitude     Float
  mapConfig     Json?
  contactEmail  String                 @db.VarChar(255)
  contactPhone  String                 @db.VarChar(15)
  status        EntityStatus           @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  isVerified    Boolean                @default(false)
  ambulances    Ambulance[]
  appointments  Appointment[]
  counters      Counter[]
  departments   Department[]
  doctors       Doctor[]
  kiosks        Esp32Kiosk[]
  announcements HospitalAnnouncement[]
  city          City                   @relation(fields: [cityId], references: [id])
  queues        Queue[]
  rooms         Room[]
  staff         Staff[]
  subscription  Subscription?
  users         User[]

  @@index([cityId, type, speciality])
  @@map("hospitals")
}

model Department {
  id           String        @id @default(uuid())
  hospitalId   String
  name         String        @db.VarChar(100)
  code         String        @db.VarChar(20)
  description  String?
  status       EntityStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  queues       Queue[]
  rooms        Room[]

  @@unique([hospitalId, code])
  @@map("departments")
}

model Room {
  id           String       @id @default(uuid())
  hospitalId   String
  departmentId String
  roomNumber   String       @db.VarChar(20)
  floor        String       @db.VarChar(20)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  doctors      Doctor[]
  queues       Queue[]
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hospital     Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, roomNumber])
  @@map("rooms")
}

model Counter {
  id            String       @id @default(uuid())
  hospitalId    String
  counterNumber String       @db.VarChar(20)
  purpose       String       @db.VarChar(100)
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  hospital      Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  queues        Queue[]

  @@unique([hospitalId, counterNumber])
  @@map("counters")
}

model Patient {
  id                    String            @id @default(uuid())
  userId                String            @unique
  uhid                  String            @unique @db.VarChar(30)
  firstName             String            @db.VarChar(100)
  lastName              String            @db.VarChar(100)
  gender                Gender
  dateOfBirth           DateTime          @db.Date
  bloodGroup            String?           @db.VarChar(5)
  address               String?
  emergencyContactName  String?           @db.VarChar(100)
  emergencyContactPhone String?           @db.VarChar(15)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  appointments          Appointment[]
  familyMembers         FamilyMember[]    @relation("PrimaryPatient")
  asFamilyMember        FamilyMember[]    @relation("RelatedPatient")
  feedbacks             Feedback[]
  medicalDocuments      MedicalDocument[]
  medicalHistories      MedicalHistory[]
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments              Payment[]
  prescriptions         Prescription[]
  queues                Queue[]
  reports               Report[]

  @@map("patients")
}

model Doctor {
  id              String         @id @default(uuid())
  userId          String         @unique
  hospitalId      String
  departmentId    String
  roomId          String?
  licenseNumber   String         @unique @db.VarChar(100)
  firstName       String         @db.VarChar(100)
  lastName        String         @db.VarChar(100)
  qualification   String         @db.VarChar(255)
  consultationFee Decimal        @db.Decimal(10, 2)
  isAvailable     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  appointments    Appointment[]
  department      Department     @relation(fields: [departmentId], references: [id])
  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  room            Room?          @relation(fields: [roomId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions   Prescription[]
  queues          Queue[]
  reports         Report[]

  @@map("doctors")
}

model Staff {
  id         String    @id @default(uuid())
  userId     String    @unique
  hospitalId String
  type       StaffType
  firstName  String    @db.VarChar(100)
  lastName   String    @db.VarChar(100)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reports    Report[]  @relation("LabTechReports")
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model FamilyMember {
  id               String   @id @default(uuid())
  primaryPatientId String
  relatedPatientId String?
  fullName         String   @db.VarChar(200)
  relationship     String   @db.VarChar(50)
  gender           Gender
  dateOfBirth      DateTime @db.Date
  createdAt        DateTime @default(now())
  primaryPatient   Patient  @relation("PrimaryPatient", fields: [primaryPatientId], references: [id], onDelete: Cascade)
  relatedPatient   Patient? @relation("RelatedPatient", fields: [relatedPatientId], references: [id])

  @@map("family_members")
}

model Appointment {
  id              String            @id @default(uuid())
  hospitalId      String
  departmentId    String
  doctorId        String
  patientId       String
  appointmentType AppointmentType
  status          AppointmentStatus @default(BOOKED)
  appointmentDate DateTime          @db.Date
  slotTime        DateTime
  qrCodeData      String            @unique
  tokenNumber     String            @db.VarChar(20)
  symptoms        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  department      Department        @relation(fields: [departmentId], references: [id])
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id])
  payments        Payment[]
  prescriptions   Prescription[]
  queue           Queue?
  reports         Report[]

  @@index([hospitalId, appointmentDate, status])
  @@map("appointments")
}

model Queue {
  id                   String      @id @default(uuid())
  hospitalId           String
  departmentId         String
  roomId               String?
  counterId            String?
  appointmentId        String      @unique
  patientId            String
  doctorId             String
  tokenNumber          Int
  status               QueueStatus @default(WAITING)
  priorityLevel        Int         @default(0)
  estimatedWaitMinutes Int         @default(0)
  checkedInAt          DateTime?
  calledAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  appointment          Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  counter              Counter?    @relation(fields: [counterId], references: [id])
  department           Department  @relation(fields: [departmentId], references: [id])
  doctor               Doctor      @relation(fields: [doctorId], references: [id])
  hospital             Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient              Patient     @relation(fields: [patientId], references: [id])
  room                 Room?       @relation(fields: [roomId], references: [id])

  @@index([hospitalId, doctorId, status, priorityLevel])
  @@map("queues")
}

model MedicalHistory {
  id         String   @id @default(uuid())
  patientId  String
  condition  String   @db.VarChar(255)
  diagnosis  String
  allergies  String?
  surgeries  String?
  recordedAt DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_histories")
}

model Prescription {
  id            String             @id @default(uuid())
  appointmentId String
  patientId     String
  doctorId      String
  diagnosis     String
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         PrescriptionItem[]
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  patient       Patient            @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineName   String       @db.VarChar(255)
  dosage         String       @db.VarChar(100)
  frequency      String       @db.VarChar(100)
  durationDays   Int
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model Report {
  id            String       @id @default(uuid())
  appointmentId String?
  patientId     String
  doctorId      String
  labTechId     String?
  title         String       @db.VarChar(255)
  testType      String       @db.VarChar(100)
  status        TestStatus   @default(PENDING)
  fileUrl       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  labTech       Staff?       @relation("LabTechReports", fields: [labTechId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])

  @@map("reports")
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String
  patientId     String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR") @db.VarChar(10)
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  transactionId String?       @unique @db.VarChar(255)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])

  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  title     String   @db.VarChar(255)
  body      String
  isRead    Boolean  @default(false)
  metaData  Json?
  createdAt DateTime @default(now())
  sender    User?    @relation("SenderUser", fields: [senderId], references: [id])
  user      User     @relation("RecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Feedback {
  id         String   @id @default(uuid())
  hospitalId String
  patientId  String
  userId     String
  rating     Int      @db.SmallInt
  comments   String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Ambulance {
  id            String       @id @default(uuid())
  hospitalId    String
  vehicleNumber String       @unique @db.VarChar(50)
  driverName    String       @db.VarChar(100)
  driverPhone   String       @db.VarChar(15)
  isAvailable   Boolean      @default(true)
  currentLat    Float?
  currentLong   Float?
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  hospital      Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("ambulances")
}

model HospitalAnnouncement {
  id         String   @id @default(uuid())
  hospitalId String
  title      String   @db.VarChar(255)
  message    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("hospital_announcements")
}

model Esp32Kiosk {
  id         String   @id @default(uuid())
  hospitalId String
  deviceMac  String   @unique @db.VarChar(17)
  location   String   @db.VarChar(100)
  secretKey  String   @db.VarChar(255)
  isActive   Boolean  @default(true)
  lastPingAt DateTime @default(now())
  createdAt  DateTime @default(now())
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("esp32_kiosks")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  subject     String   @db.VarChar(255)
  description String
  status      String   @default("OPEN") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @db.VarChar(255)
  metaData  Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model MedicalDocument {
  id            String         @id @default(uuid())
  patientId     String
  uploadedById  String
  documentType  DocumentType   @default(OTHER)
  title         String         @db.VarChar(255)
  fileName      String         @db.VarChar(255)
  fileUrl       String
  mimeType      String         @db.VarChar(100)
  fileSize      Int?
  documentDate  DateTime?
  status        DocumentStatus @default(PROCESSING)
  extractedData Json?
  summary       String?
  disclaimer    String?
  isVerified    Boolean        @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  patientNotes  String?
  doctorNotes   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)
  verifiedBy    User?          @relation("VerifiedDocuments", fields: [verifiedById], references: [id])

  @@index([patientId, documentType, status])
  @@map("medical_documents")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum HospitalType {
  GOVERNMENT
  PRIVATE
}

enum SpecialityType {
  EYE
  DENTAL
  AYURVEDIC
  HOMEOPATHY
  ALLOPATHY
  GENERAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StaffType {
  RECEPTIONIST
  LAB_TECHNICIAN
  AMBULANCE_DRIVER
  ADMIN
  OTHER
}

enum AppointmentType {
  WALK_IN
  ONLINE
  EMERGENCY
  TELECONSULTATION
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  SKIPPED
  RECALLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  INSURANCE
}

enum TestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  NEEDS_REVIEW
  VERIFIED_BY_PATIENT
  DOCTOR_VERIFIED
  FAILED
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  MEDICAL_REPORT
  OTHER
}
